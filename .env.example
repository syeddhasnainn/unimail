# Password for logging into the web UI. Use something long and random.
UNIMAIL_PASSWORD=change-me
# Signs login sessions and encrypts stored mailbox passwords (generate with: openssl rand -base64 32)
# Keep it safe and never change it, or every account has to be added again.
UNIMAIL_SECRET=
# Where the SQLite database lives
DATABASE_PATH=data/unimail.db
# Optional. OpenRouter key for AI email classification (anthropic/claude-haiku-5.5). Leave empty to turn it off.
OPENROUTER_API_KEY=
# Optional. Port and interface for `pnpm start` (defaults: 3000 on all interfaces).
# Set HOST=127.0.0.1 when a reverse proxy sits in front.
# PORT=3000
# HOST=127.0.0.1
