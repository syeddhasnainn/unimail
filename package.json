{
  "name": "unimail",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "concurrently --names web,sync --prefix-colors cyan,magenta --kill-others-on-fail \"pnpm:dev:web\" \"pnpm:dev:sync\"",
    "dev:web": "vite dev --port 3000",
    "dev:sync": "tsx watch --env-file-if-exists=.env src/sync/main.ts",
    "start": "concurrently --names web,sync --prefix-colors cyan,magenta --kill-others-on-fail \"pnpm:start:web\" \"pnpm:sync\"",
    "start:web": "node --env-file-if-exists=.env .output/server/index.mjs",
    "sync": "node --env-file-if-exists=.env --import tsx src/sync/main.ts",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@effect/ai-openrouter": "4.0.5",
    "@effect/platform-node": "^4.0.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@solar-icons/react": "2.3.3",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "latest",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "concurrently": "^10.0.6",
    "drizzle-orm": "^0.45.4",
    "effect": "^4.0.5",
    "fast-xml-parser": "^5.11.2",
    "imapflow": "^2.5.8",
    "mailparser": "^3.10.0",
    "nitro": "3.0.260903-beta",
    "nodemailer": "^10.1.7",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.167.39",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.2",
    "vite": "^8"
  }
}
